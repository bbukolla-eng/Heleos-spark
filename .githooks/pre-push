#!/bin/bash
# Heleos-spark lane guard (git layer): Claude Code may only push the lane to origin.
# Arguments: $1 = remote name, $2 = remote URL. Stdin: <local ref> <local sha> <remote ref> <remote sha>
. "$(dirname "${BASH_SOURCE[0]}")/lane_common.sh"
lane_hooks_active || exit 0
LANE="$(lane_branch_name)"
[ -n "$LANE" ] || exit 0
REMOTE_NAME="$1"
REMOTE_URL="$2"
ORIGIN_URL="$(git remote get-url origin 2>/dev/null)"
if [ "$REMOTE_NAME" != "origin" ] && [ "$REMOTE_URL" != "$ORIGIN_URL" ]; then
  echo "[BranchGuard] push blocked: Claude Code pushes the lane to origin only (got '$REMOTE_NAME')." >&2
  exit 1
fi
ZERO="0000000000000000000000000000000000000000"
STATUS=0
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  [ -n "$REMOTE_REF" ] || continue
  if [ "$LOCAL_SHA" = "$ZERO" ]; then
    echo "[BranchGuard] push blocked: deleting '$REMOTE_REF' is not allowed." >&2
    STATUS=1
    continue
  fi
  if [ "$REMOTE_REF" != "refs/heads/$LANE" ]; then
    echo "[BranchGuard] push blocked: '$REMOTE_REF' is not the lane 'refs/heads/$LANE'." >&2
    STATUS=1
    continue
  fi
  if [ "$REMOTE_SHA" != "$ZERO" ] && ! git merge-base --is-ancestor "$REMOTE_SHA" "$LOCAL_SHA" 2>/dev/null; then
    echo "[BranchGuard] push blocked: non-fast-forward update of the lane (force push)." >&2
    STATUS=1
  fi
done
exit $STATUS
