+        let source_digest = Sha256Digest::hash_reader(source.as_slice()).expect("hash test source");
+        let winner_calls = Cell::new(0_u8);
+        let publish_winner = |point, digest| {
+            if point != AccountedPublicationTestPoint::Original {
+                return Ok(());
+            }
