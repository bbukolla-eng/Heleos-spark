+            QUARANTINE_BYTES
+                .checked_sub(source_length)
+                .and_then(|value| value.checked_sub(manifest_length))
+                .and_then(|value| value.checked_add(excess_bytes))
+                .expect("bounded manifest orphan pressure"),
