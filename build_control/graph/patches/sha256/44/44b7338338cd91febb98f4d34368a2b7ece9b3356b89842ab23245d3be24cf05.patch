+  "$id": "https://helios.local/build-control/schemas/source-record-v1.schema.json",
+  "title": "Canonical source identity v1",
+  "type": "object",
+  "additionalProperties": false,
+  "required": ["protocol", "source_id", "identity_kind", "original_source_url", "authorized_document_id", "publisher", "title", "publication_date", "effective_date", "retrieval_date", "jurisdiction", "data_class", "authority_class", "license_use_notes", "content_sha256"],
+  "properties": {
+    "protocol": {"const": "helios.build.source-record/v1"},
+    "source_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
+    "identity_kind": {"enum": ["PUBLIC_URL", "AUTHORIZED_DOCUMENT"]},
+    "original_source_url": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
+    "authorized_document_id": {"anyOf": [{"$ref": "common-v1.schema.json#/$defs/nonEmptyString"}, {"type": "null"}]},
+    "publisher": {"$ref": "common-v1.schema.json#/$defs/nonEmptyString"},
+    "title": {"$ref": "common-v1.schema.json#/$defs/nonEmptyString"},
+    "publication_date": {"$ref": "#/$defs/nullableDate"},
+    "effective_date": {"$ref": "#/$defs/nullableDate"},
+    "retrieval_date": {"$ref": "#/$defs/date"},
+    "jurisdiction": {"$ref": "common-v1.schema.json#/$defs/nonEmptyString"},
+    "data_class": {"enum": ["PUBLIC", "AUTHORIZED_LICENSED"]},
+    "authority_class": {"enum": ["PRIMARY_PUBLIC", "AUTHORIZED_LICENSED", "REPUTABLE_SECONDARY", "DISCOVERY_ONLY"]},
+    "license_use_notes": {"$ref": "common-v1.schema.json#/$defs/nonEmptyString"},
+    "content_sha256": {"anyOf": [{"$ref": "common-v1.schema.json#/$defs/digest"}, {"type": "null"}]}
+  },
+  "allOf": [
+    {
+      "if": {"properties": {"identity_kind": {"const": "PUBLIC_URL"}}},
+      "then": {"properties": {"original_source_url": {"type": "string", "minLength": 1}, "authorized_document_id": {"type": "null"}}}
+    },
+    {
+      "if": {"properties": {"identity_kind": {"const": "AUTHORIZED_DOCUMENT"}}},
+      "then": {"properties": {"original_source_url": {"type": "null"}, "authorized_document_id": {"$ref": "common-v1.schema.json#/$defs/nonEmptyString"}}}
+    }
+  ],
+  "$defs": {
+    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
+    "nullableDate": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]}
+  }
+}
diff --git a/build_control/source_registry/README.md b/build_control/source_registry/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..676be09306260b80112b09a84e52bfc6c00bb3d0
--- /dev/null
+++ b/build_control/source_registry/README.md
@@ -0,0 +1,13 @@
+# Build-time source registry
+
+This directory stores canonical, sanitized metadata for research used to build HELIOS. It is not a research database and it grants no runtime, engineering, quantity, pricing, approval, or bid authority.
+
+- The notebook manifest defines logical research domains. It contains no live NotebookLM URL, provider notebook ID, account identity, credential, or session state.
+- Source bodies, copyrighted documents, private project files, prompts, responses, and browser artifacts are never stored here.
+- One canonical source identity can be cited from many packets and logical notebooks. The source object is stored once; packet and notebook memberships remain visible in the append-only import ledger.
+- Packet and source objects are immutable and content-addressed. A corrected packet uses a new packet ID and an explicit predecessor. One predecessor cannot fork into several successors.
+- Packet import validates the entire requested batch before publishing objects and appends one final authoritative import event only after every object is safely published. Objects left without that final event after a storage interruption are unreachable and do not count as imported.
+- Exact replay is idempotent. Reuse of an identity with different bytes fails closed.
+- Provider removal or later correction never erases prior packet, source, membership, conflict, limitation, or gap history.
+
+Codex and Claude consume only a deterministic BuilderSourceBundle tied to a frozen BuildTask's declared, integrated `SourcePacket` graph nodes. The bundle remains advisory input to later reviewed implementation work.
