+    ) -> tuple[str, dict[str, object]]:
+        node_ids = [node_id for node_id, _ in packet_nodes]
+        task = valid_task_manifest()
+        task["task_id"] = "builder-consumes-research"
+        task["base_commit_sha"] = "d" * 40
+        task["dependency_node_ids"] = node_ids
