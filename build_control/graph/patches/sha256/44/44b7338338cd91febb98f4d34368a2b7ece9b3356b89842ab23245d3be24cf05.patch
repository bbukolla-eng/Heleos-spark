+  "$defs": {
+    "dependency": {"type": "object", "additionalProperties": false, "required": ["dependency_node_id", "packet_id", "packet_sha256"], "properties": {"dependency_node_id": {"$ref": "common-v1.schema.json#/$defs/identifier"}, "packet_id": {"$ref": "common-v1.schema.json#/$defs/identifier"}, "packet_sha256": {"$ref": "common-v1.schema.json#/$defs/digest"}}},
