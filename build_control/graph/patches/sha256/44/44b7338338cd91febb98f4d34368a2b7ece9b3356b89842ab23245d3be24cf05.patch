+    "source": {"type": "object", "additionalProperties": false, "required": ["source_record_sha256", "source", "packet_ids", "notebook_ids"], "properties": {"source_record_sha256": {"$ref": "common-v1.schema.json#/$defs/digest"}, "source": {"$ref": "source-record-v1.schema.json"}, "packet_ids": {"$ref": "common-v1.schema.json#/$defs/stringArray"}, "notebook_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^N[0-9]{2}$"}}}},
+    "citation": {"type": "object", "additionalProperties": false, "required": ["packet_id", "notebook_id", "citation"], "properties": {"packet_id": {"$ref": "common-v1.schema.json#/$defs/identifier"}, "notebook_id": {"type": "string", "pattern": "^N[0-9]{2}$"}, "citation": {"$ref": "source-packet-v1.schema.json#/$defs/citation"}}},
+    "finding": {"type": "object", "additionalProperties": false, "required": ["packet_id", "notebook_id", "finding"], "properties": {"packet_id": {"$ref": "common-v1.schema.json#/$defs/identifier"}, "notebook_id": {"type": "string", "pattern": "^N[0-9]{2}$"}, "finding": {"$ref": "source-packet-v1.schema.json#/$defs/finding"}}},
+    "conflict": {"type": "object", "additionalProperties": false, "required": ["packet_id", "notebook_id", "conflict"], "properties": {"packet_id": {"$ref": "common-v1.schema.json#/$defs/identifier"}, "notebook_id": {"type": "string", "pattern": "^N[0-9]{2}$"}, "conflict": {"$ref": "source-packet-v1.schema.json#/$defs/conflict"}}},
+    "limitation": {"type": "object", "additionalProperties": false, "required": ["packet_id", "notebook_id", "text"], "properties": {"packet_id": {"$ref": "common-v1.schema.json#/$defs/identifier"}, "notebook_id": {"type": "string", "pattern": "^N[0-9]{2}$"}, "text": {"$ref": "common-v1.schema.json#/$defs/nonEmptyString"}}},
