+                            citation["source_ref"], _json_text(citation),
+                        ),
+                    )
+
+    @staticmethod
+    def _append_event(connection: sqlite3.Connection, *, pack_sha256: str, event_type: str) -> None:
+        prior = connection.execute(
+            """
+            SELECT event_sequence, event_sha256 FROM engine_registry_events
+            WHERE pack_sha256 = ? ORDER BY event_sequence DESC LIMIT 1
+            """,
+            (pack_sha256,),
