+    @classmethod
+    def _insert_projections(cls, connection: sqlite3.Connection, compiled: CompiledDomainPack) -> None:
+        document = cast(dict[str, object], json.loads(compiled.canonical_bytes))
+        digest = compiled.sha256
+        for source in cast(list[dict[str, object]], document["sources"]):
+            connection.execute(
+                "INSERT INTO engine_source_index(pack_sha256, source_id, source_json) VALUES (?, ?, ?)",
