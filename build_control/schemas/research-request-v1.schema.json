{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helios.local/build-control/schemas/research-request-v1.schema.json",
  "title": "HELIOS build research request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "request_id", "task_id", "target_engine_component_id", "question", "jurisdiction", "unit_system", "data_class", "required_source_authority_class", "target_notebook_id", "excluded_source_ids", "excluded_data_classes", "required_output_protocol", "priority", "deadline", "issued_at", "issuer", "notebook_manifest_sha256", "athena_profile_sha256"],
  "properties": {
    "protocol": {"const": "helios.build.research-request/v1"},
    "request_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
    "task_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
    "target_engine_component_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
    "question": {"$ref": "common-v1.schema.json#/$defs/nonEmptyString"},
    "jurisdiction": {"$ref": "common-v1.schema.json#/$defs/nonEmptyString"},
    "unit_system": {"const": "US_CUSTOMARY"},
    "data_class": {"enum": ["PUBLIC", "AUTHORIZED_LICENSED"]},
    "required_source_authority_class": {"$ref": "#/$defs/authorityClass"},
    "target_notebook_id": {"type": "string", "pattern": "^N[0-9]{2}$"},
    "excluded_source_ids": {"$ref": "common-v1.schema.json#/$defs/stringArray"},
    "excluded_data_classes": {"type": "array", "uniqueItems": true, "items": {"enum": ["PUBLIC", "AUTHORIZED_LICENSED", "INTERNAL", "PROJECT_CONFIDENTIAL", "SECRET"]}},
    "required_output_protocol": {"const": "helios.build.source-packet/v1"},
    "priority": {"enum": ["LOW", "NORMAL", "HIGH", "CRITICAL"]},
    "deadline": {"$ref": "common-v1.schema.json#/$defs/rfc3339Utc"},
    "issued_at": {"$ref": "common-v1.schema.json#/$defs/rfc3339Utc"},
    "issuer": {"$ref": "#/$defs/issuer"},
    "notebook_manifest_sha256": {"$ref": "common-v1.schema.json#/$defs/digest"},
    "athena_profile_sha256": {"$ref": "common-v1.schema.json#/$defs/digest"}
  },
  "$defs": {
    "authorityClass": {"enum": ["PRIMARY_PUBLIC", "AUTHORIZED_LICENSED", "REPUTABLE_SECONDARY", "DISCOVERY_ONLY"]},
    "issuer": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["worker_id", "role"], "properties": {"worker_id": {"const": "CODEX"}, "role": {"const": "CODEX_CONTROL"}}},
        {"type": "object", "additionalProperties": false, "required": ["worker_id", "role"], "properties": {"worker_id": {"const": "CLAUDE"}, "role": {"const": "CLAUDE_ARCHITECTURE"}}}
      ]
    }
  }
}
