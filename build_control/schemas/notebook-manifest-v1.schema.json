{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helios.local/build-control/schemas/notebook-manifest-v1.schema.json",
  "title": "HELIOS logical notebook manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "manifest_version", "supersedes_manifest_sha256", "notebooks"],
  "properties": {
    "protocol": {"const": "helios.build.notebook-manifest/v1"},
    "manifest_version": {"type": "integer", "minimum": 1},
    "supersedes_manifest_sha256": {"$ref": "#/$defs/nullableDigest"},
    "notebooks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/notebook"}
    }
  },
  "$defs": {
    "nullableDigest": {
      "anyOf": [
        {"$ref": "common-v1.schema.json#/$defs/digest"},
        {"type": "null"}
      ]
    },
    "notebook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notebook_id", "name", "purpose"],
      "properties": {
        "notebook_id": {"type": "string", "pattern": "^N[0-9]{2}$"},
        "name": {"$ref": "common-v1.schema.json#/$defs/nonEmptyString"},
        "purpose": {"$ref": "common-v1.schema.json#/$defs/nonEmptyString"}
      }
    }
  }
}
