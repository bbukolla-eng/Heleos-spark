{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helios.local/build-control/schemas/source-packet-v1.schema.json",
  "title": "ATHENA cited source packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "packet_id", "request_id", "request_sha256", "supersedes_packet_id", "notebook_id", "notebook_manifest_sha256", "athena_profile_sha256", "jurisdiction", "unit_system", "generated_at", "sources", "citations", "findings", "conflicts", "limitations", "unanswered_questions", "synthesis_provenance"],
  "properties": {
    "protocol": {"const": "helios.build.source-packet/v1"},
    "packet_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
    "request_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
    "request_sha256": {"$ref": "common-v1.schema.json#/$defs/digest"},
    "supersedes_packet_id": {"anyOf": [{"$ref": "common-v1.schema.json#/$defs/identifier"}, {"type": "null"}]},
    "notebook_id": {"type": "string", "pattern": "^N[0-9]{2}$"},
    "notebook_manifest_sha256": {"$ref": "common-v1.schema.json#/$defs/digest"},
    "athena_profile_sha256": {"$ref": "common-v1.schema.json#/$defs/digest"},
    "jurisdiction": {"$ref": "common-v1.schema.json#/$defs/nonEmptyString"},
    "unit_system": {"const": "US_CUSTOMARY"},
    "generated_at": {"$ref": "common-v1.schema.json#/$defs/rfc3339Utc"},
    "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "source-record-v1.schema.json"}},
    "citations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://helios.local/build-control/schemas/source-packet-v1.schema.json#/$defs/citation"}},
    "findings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://helios.local/build-control/schemas/source-packet-v1.schema.json#/$defs/finding"}},
    "conflicts": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://helios.local/build-control/schemas/source-packet-v1.schema.json#/$defs/conflict"}},
    "limitations": {"$ref": "common-v1.schema.json#/$defs/stringArray"},
    "unanswered_questions": {"$ref": "common-v1.schema.json#/$defs/stringArray"},
    "synthesis_provenance": {"$ref": "https://helios.local/build-control/schemas/source-packet-v1.schema.json#/$defs/synthesis"}
  },
  "$defs": {
    "nullableString": {"anyOf": [{"$ref": "common-v1.schema.json#/$defs/nonEmptyString"}, {"type": "null"}]},
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation_id", "source_id", "resolution", "locator", "limitation"],
      "properties": {
        "citation_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
        "source_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
        "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]},
        "locator": {"$ref": "https://helios.local/build-control/schemas/source-packet-v1.schema.json#/$defs/nullableString"},
        "limitation": {"$ref": "https://helios.local/build-control/schemas/source-packet-v1.schema.json#/$defs/nullableString"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "statement", "citation_ids", "applicability", "confidence", "proposed_engine_implication"],
      "properties": {
        "finding_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
        "statement": {"$ref": "common-v1.schema.json#/$defs/nonEmptyString"},
        "citation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common-v1.schema.json#/$defs/identifier"}},
        "applicability": {"$ref": "common-v1.schema.json#/$defs/nonEmptyString"},
        "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "proposed_engine_implication": {"$ref": "common-v1.schema.json#/$defs/nonEmptyString"}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conflict_id", "description", "citation_ids"],
      "properties": {
        "conflict_id": {"$ref": "common-v1.schema.json#/$defs/identifier"},
        "description": {"$ref": "common-v1.schema.json#/$defs/nonEmptyString"},
        "citation_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "common-v1.schema.json#/$defs/identifier"}}
      }
    },
    "synthesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "query_sha256", "response_sha256", "external_evidence_sha256", "observed_at"],
      "properties": {
        "provider": {"const": "ATHENA_NOTEBOOKLM"},
        "query_sha256": {"$ref": "common-v1.schema.json#/$defs/digest"},
        "response_sha256": {"$ref": "common-v1.schema.json#/$defs/digest"},
        "external_evidence_sha256": {"$ref": "common-v1.schema.json#/$defs/digest"},
        "observed_at": {"$ref": "common-v1.schema.json#/$defs/rfc3339Utc"}
      }
    }
  }
}
