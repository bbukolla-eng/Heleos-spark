{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helios.local/build-control/schemas/worker-profile-v1.schema.json",
  "title": "HELIOS Build Fabric worker profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "profile_id",
    "worker_id",
    "display_name",
    "roles",
    "transports",
    "adapter_protocol",
    "skills",
    "plugins",
    "allowed_tools",
    "allowed_data_classes",
    "allowed_task_purposes",
    "authority_limits",
    "max_concurrency"
  ],
  "properties": {
    "protocol": { "const": "helios.build.worker-profile/v1" },
    "profile_id": { "$ref": "common-v1.schema.json#/$defs/identifier" },
    "worker_id": { "$ref": "common-v1.schema.json#/$defs/identifier" },
    "display_name": { "$ref": "common-v1.schema.json#/$defs/nonEmptyString" },
    "roles": {
      "type": "array",
      "items": { "enum": ["CONTROLLER", "ARCHITECT", "BUILDER", "REVIEWER", "INTEGRATOR"] },
      "uniqueItems": true
    },
    "transports": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["LOCAL_ADAPTER", "EXTERNAL_SESSION"] },
      "uniqueItems": true
    },
    "adapter_protocol": {
      "anyOf": [
        { "$ref": "common-v1.schema.json#/$defs/nonEmptyString" },
        { "type": "null" }
      ]
    },
    "skills": { "$ref": "#/$defs/grants" },
    "plugins": { "$ref": "#/$defs/grants" },
    "allowed_tools": { "$ref": "common-v1.schema.json#/$defs/stringArray" },
    "allowed_data_classes": { "$ref": "common-v1.schema.json#/$defs/stringArray" },
    "allowed_task_purposes": { "$ref": "common-v1.schema.json#/$defs/stringArray" },
    "authority_limits": { "$ref": "common-v1.schema.json#/$defs/stringArray" },
    "max_concurrency": { "$ref": "common-v1.schema.json#/$defs/nonNegativeInteger" }
  },
  "$defs": {
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision", "allowed_tools", "purpose"],
      "properties": {
        "name": { "$ref": "common-v1.schema.json#/$defs/nonEmptyString" },
        "revision": { "$ref": "common-v1.schema.json#/$defs/nonEmptyString" },
        "allowed_tools": { "$ref": "common-v1.schema.json#/$defs/stringArray" },
        "purpose": { "$ref": "common-v1.schema.json#/$defs/nonEmptyString" }
      }
    },
    "grants": {
      "type": "array",
      "items": { "$ref": "#/$defs/grant" },
      "uniqueItems": true
    }
  }
}
