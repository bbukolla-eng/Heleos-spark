  cargo +1.96.1 test --frozen -p heleos-verification --all-targets

# Rust owns the full-graph generation, fixed epoch, two-root comparison, and
# semantic validation. Raw cargo-cyclonedx member output is never an aggregate.
task_output="$(mktemp -d "$task_root/target/supply-chain.XXXXXX")"
scripts/verify-provenance build-sbom "$task_output/heleos-foundation-0.1.cdx.json"
scripts/verify-provenance verify-sbom "$task_output/heleos-foundation-0.1.cdx.json"
cmp artifacts/sbom/heleos-foundation-0.1.cdx.json "$task_output/heleos-foundation-0.1.cdx.json" || fail 'regenerated semantic SBOM differs from the admitted artifact'
check_hash artifacts/sbom/heleos-foundation-0.1.cdx.json "$task_sbom_sha256"
scripts/verify-provenance verify-sbom artifacts/sbom/heleos-foundation-0.1.cdx.json
scripts/verify-provenance
