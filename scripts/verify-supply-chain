run_deny_audit
cargo +1.96.1 audit --no-fetch --db "$task_cargo_home/advisory-db" --deny warnings
# Scan history and a direct regular-file snapshot of Git source inputs. Ignored
# target/cache copies must not multiply findings or become source authority.
task_secret_evidence="$(mktemp -d "${TMPDIR:-/tmp}/heleos-supply-chain.XXXXXX")"
task_secret_snapshot="$task_secret_evidence/source"
mkdir "$task_secret_snapshot"
task_scan_paths="$(git ls-files --cached --others --exclude-standard)"
[[ -n "$task_scan_paths" ]] || fail 'empty secret-scan source inventory'
while IFS= read -r task_path; do
  [[ "$task_path" =~ ^[A-Za-z0-9_./-]+$ && -f "$task_path" ]] || fail 'unsupported secret-scan source input'
  task_parent="$task_path"
  while [[ "$task_parent" != . ]]; do
    [[ ! -L "$task_parent" ]] || fail 'indirect secret-scan source input'
    task_parent="$(dirname -- "$task_parent")"
  done
  mkdir -p "$task_secret_snapshot/$(dirname -- "$task_path")"
  cp -p "$task_path" "$task_secret_snapshot/$task_path"
  cmp "$task_path" "$task_secret_snapshot/$task_path" || fail 'secret-scan source copy drift'
done <<< "$task_scan_paths"
gitleaks git --redact=100 --ignore-gitleaks-allow --log-opts=--all --exit-code 0 \
  --report-format json --report-path "$task_secret_evidence/history.json" . \
  >"$task_secret_evidence/history.log" 2>&1 || fail 'history secret scan failed; redacted diagnostics retained in OS-temp evidence'
gitleaks dir --redact=100 --ignore-gitleaks-allow --exit-code 0 \
  --report-format json --report-path "$task_secret_evidence/current.json" "$task_secret_snapshot" \
  >"$task_secret_evidence/current.log" 2>&1 || fail 'current-source secret scan failed; redacted diagnostics retained in OS-temp evidence'
# Exit-code 0 only permits report collection; exact governed finding adjudication
# is mandatory and owned by the semantic verifier, never a generic ignore.
scripts/verify-provenance verify-secret-scan "$task_secret_evidence/history.json" "$task_secret_evidence/current.json"

export HELEOS_BIN="$task_root/target/debug/heleos"
export HELEOS_PDF_GUEST="$task_root/target/wasm32-wasip1/release/heleos_pdf_guest.wasm"
cargo +1.96.1 clippy --frozen --workspace --all-targets --all-features -- -D warnings
cargo +1.96.1 build --frozen -p heleos-cli --bin heleos
